#!/usr/bin/env python3
"""rein v2 진입점 (plan Task 4.7 — 서브커맨드 라우팅 추가, spec §3.1 cli/).

세 진입 경로:
- **인자 없음** (기존 계약, Task 1.1 — 절대 파손 금지): stdin 으로
  이벤트 JSON 1건 → stdout 으로 decision JSON 1건. v1 perf 하니스
  (`tests/perf/spike1_coldstart.py`)와 `tests/unit/test_scaffold_roundtrip.py`
  가 이 왕복 정확히 그대로에 의존한다 — 인자 파싱을 추가하되 이 경로의
  입출력 형태·환경변수 계약(REIN_POLICY_DIR/REIN_DB_PATH)은 손대지 않는다.
- **`doctor`**: `rein/cli/doctor.py::run_doctor` — 설정/policy/storage
  상태 JSON 을 stdout 에 출력.
- **`explain <event-json>|-`**: `rein/cli/explain.py::run_explain` —
  인자로 이벤트 JSON 문자열을 받거나(`-` 또는 인자 생략 시 stdin 에서
  읽음) 근거 JSON 을 stdout 에 출력.
- **`hook`**: `rein/cli/__init__.py::run_hook_event` — stdin 으로 이벤트
  JSON 1건을 받아 Claude native hook 응답 JSON 1건을 stdout 에 출력
  (Task 6.1 선행1). 인자 없음 경로와 달리 REIN_POLICY_DIR/
  REIN_PROJECT_ROOT/REIN_DB_PATH 세 환경변수가 전부 미설정이어도
  자립 규칙으로 판정이 일어난다(`run_hook_event()` docstring 참조) —
  hooks.json 라우팅 전환(Task 6.1 본작업, 이 파일 범위 밖)이 실제로
  가리킬 서브커맨드다. `_run_hook()` 아래 절 참조.
- **`issue-evidence <capability> --print-digest`** /
  **`issue-evidence <capability> --print-subject`** /
  **`issue-evidence <capability> --verdict <V> --reviewed-digest <D>`**:
  `rein/cli/issue_evidence.py` — Phase 7 웨이브 3 ③-a. codex-review/
  security-reviewer 같은 리뷰 스킬(또는 사람)이 code_review/
  security_review v2 evidence 를 실제로 ledger 에 적재하는 유일한 shell
  진입점이다(`issue_code_review_evidence`/`issue_security_review_
  evidence` 는 Phase 3/4 부터 있었지만 이 서브커맨드가 생기기 전까지는
  프로덕션 호출자가 전혀 없었다 — "zero production callers" 갭,
  `issue_evidence.py` 모듈 docstring 참조). `--print-digest` 는 부작용
  없이 현재 subject digest 만 출력하고, `--print-subject`(both
  capability 지원, 2026-08-20 code review round 3 정제 — 이전 code_
  review 전용 `--print-subject-paths` 를 대체)는 그 digest 와 digest 가
  실제로 흡수하는 인증된 경로 목록을 **같은 changeset 조회 한 번**에서
  함께 담은 JSON 한 줄(`{"subject": ..., "paths": [...]}`)을 출력한다(
  `/codex-review` 래퍼·`agents/security-reviewer.md` 가 리뷰 대상 파일
  집합을 다이제스트 범위와 정확히 맞추는 데 쓴다 — 두 값을 별도 호출로
  얻으면 그 사이 트리가 바뀌어 갈라질 수 있었던 문제의 수리), `--verdict`/
  `--reviewed-digest` 조합은 실제 발급을 시도한다. `_run_issue_evidence()`
  아래 절 참조.

## fail-closed 매핑 (Task 4.7 — Task 3.1 보안 리뷰가 남긴 미해결 위험의 해소)

`rein/engine/context.py` 의 `FactResolutionError` docstring 이 명시한
미해결 위험: resolver 예외(FactResolutionError 포함, ValueError 의
하위 타입이 아닌 일반 Exception 계열)가 evaluator 를 그대로 통과해
`bin/rein` 까지 전파되면, 이 스크립트는 원래 ValueError 만 잡았으므로
전파된 예외는 처리되지 않은 채 traceback + exit 1 로 끝난다. 이 저장소의
비차단 hook 규약에서 **exit 1 은 "통과"(non-blocking)** 를 뜻하므로,
그 결과는 governance 가 판단조차 못 했는데 조용히 ALLOW 로 새는 것과
같다 — 판단 불능은 거부 방향이어야 한다는 spec §3.4 의 failure_mode
사상과 정면으로 어긋난다.

### exit 1(비차단) 허용 범위 — "ValueError 전체" 가 아니라 "순수 입력 결함" 만
(2026-08-11 사이클 C 리뷰 High 수정)

최초 구현은 `except ValueError` 로 넓게 잡아 exit 1 을 허용했는데,
`rein.kernel.policy.PolicyLoadError` 도 `ValueError` 하위 타입이라 —
**손상된 policy 파일이 있으면 판단 재료 자체를 못 읽었는데도 exit 1
(조용한 ALLOW) 로 새는 구멍**이 있었다(리뷰어 실측 재현: malformed
policy 주입 → PolicyLoadError → exit 1 + 빈 stdout). "입력이 잘못됨"과
"판단 재료/판단 과정이 실패함"은 다른 사건이다 — 전자는 호출자(hook
어댑터)가 이벤트 자체를 해석하지 못한 것이고, 후자는 이벤트는 정상
해석됐지만 그 이후 판단이 불가능해진 것이다. 후자는 spec §3.4 의
failure_mode 사상(판단 불능 = 거부 방향) 그대로 적용돼야 한다.

그래서 exit 1 허용 범위를 **이벤트 자체를 해석할 수 없는 두 예외로만**
좁힌다 — 둘 다 "판단을 시작하기도 전에 입력이 깨졌다"는 명확히 구분
가능한 케이스다:

- `json.JSONDecodeError`(stdin 원문이 JSON 조차 아님)
- `rein.platform.claude.adapter.UnknownHookEventError`(hook_event_name 이
  지원 목록 밖 — payload 스키마 자체가 지원 범위를 벗어남)

이 둘을 **제외한 모든 예외**(`PolicyLoadError` 를 포함한 나머지
`ValueError` 하위 타입 전부 + `EvidenceStorageError`/`FactResolutionError`
등 `Exception` 계열)는 BLOCK decision JSON + **exit 0** 으로 번역한다
(exit 0 인 이유: hook 소비자가 이 출력을 decision JSON 으로 파싱해
BLOCK 을 실제로 집행하게 하려면, exit code 자체가 비차단 경로로 빠지면
안 되고 정상 decision 왕복과 같은 exit 0 이어야 한다 — BLOCK 은 exit
code 가 아니라 JSON 본문의 `decision` 필드로 표현된다는 기존 계약,
`rein/cli/__init__.py` 참조).

`doctor`/`explain` 서브커맨드는 hook 경로가 아니라 사람이 직접 부르는
진단 도구다 — 예외를 흡수하지 않는다. 이 스크립트는 두 서브커맨드
호출에 대해 별도 try/except 를 두지 않으므로, 내부에서 던진 예외는
Python 기본 동작(traceback stderr 출력 + exit 1)으로 그대로 드러난다.
이것이 옳은 방향인 이유: 진단 도구가 실패를 삼키면 사용자가 "진단
자체가 고장났다"는 사실을 못 보게 된다 — 눈에 띄는 실패가 진단 도구의
목적에 맞다(hook 경로의 "판단 불능 = 차단"과는 다른 안전 방향이지만,
둘 다 "조용한 성공 위장 금지"라는 상위 원칙은 공유한다).

## 예외 문자열 마스킹 (2026-08-11 사이클 C 리뷰 Medium 2)

BLOCK reason·stderr 에 실리는 예외 문자열(`str(error)`)은 resolver·
policy 로드 실패의 원인 메시지를 그대로 담을 수 있다 — 그 메시지 안에
token/credential 류가 포함돼 있으면(예: 잘못된 환경값이 에러 메시지에
echo 되는 흔한 케이스) 차단 로그로 그대로 유출된다. 이 스크립트는 자체
마스킹 규칙을 재구현하지 않고, Shadow sanitize·차단 로그 redaction 의
기존 SSOT(`rein.shadow.masking`, plan Task 2.6)를 그대로 호출해 방출
직전에 마스킹한다 — `_redact()` 참조.
"""
import json
import os
import sys
from json import JSONDecodeError

_SUBCOMMANDS = ("doctor", "explain", "hook", "issue-evidence")

# 판단 불능 시 BLOCK 매핑의 reason 템플릿 — kernel Decision.to_dict() 의
# 5필드 계약(rein/kernel/decision.py)과 형태를 맞춘다. 세부 원인 문자열은
# 이미 마스킹된 값이 채워진다(_redact 참조).
_FAILURE_REASON_TEMPLATE = (
    "unhandled exception during governance evaluation ({}) — "
    "treated as judgement failure and defaulted to BLOCK (fail-closed; "
    "see rein/engine/context.py FactResolutionError docstring and this "
    "file's module docstring)"
)


def _locate_package_parent():
    # self-location: 어떤 cwd·symlink 에서 실행돼도 패키지를 찾는다
    here = os.path.realpath(__file__)
    return os.path.dirname(os.path.dirname(here))


def _ensure_sys_path():
    # 패키지 부모 디렉토리(plugins/rein-core)만 sys.path 에 넣는다 —
    # 패키지 내부 디렉토리를 넣으면 rein/platform 이 stdlib platform 을
    # 가리게 되기 때문 (plan Task 1.1 Step 2).
    package_parent = _locate_package_parent()
    if package_parent not in sys.path:
        sys.path.insert(0, package_parent)


def _redact(text):
    """예외 문자열을 방출 직전 마스킹 SSOT 로 봉합한다 (모듈 docstring 참조).

    자체 정규식을 재구현하지 않고 `rein.shadow.masking.redact` — 이
    저장소의 "차단 로그 redaction 소비자 진입점"을 그대로 호출한다.
    """
    from rein.shadow import masking

    return masking.redact(text)


def _fail_closed_response(error):
    detail = _redact("{}: {}".format(type(error).__name__, error))
    return {
        "decision": "BLOCK",
        "reason": _FAILURE_REASON_TEMPLATE.format(detail),
        "policy": None,
        "missing_requirements": [],
        "evidence_refs": [],
    }


# native 변환 자체가 실패했을 때(잘못된 decision 값·변환기 내부 예외 등)
# 쓰는 최소 native 차단 응답 — 코드 리뷰 High 수정(2026-08-14, Task 6.1
# 선행1 1차 리뷰). "reason 을 못 얻었을 때" 만 쓰는 고정 문구.
_MINIMAL_BLOCK_REASON_FALLBACK = (
    "native hook response could not be constructed from the governance "
    "decision — failing closed without a translated reason"
)

# PreToolUse 만 permission 스키마(`hookSpecificOutput.permissionDecision`)
# 를 쓴다 — `adapter._ASK_CAPABLE_HOOKS` 와 값이 같지만, 이 상수는 여기서
# 독립적으로 재선언한다(아래 `_minimal_native_block()` 자신의 docstring
# "왜 adapter 를 다시 부르지 않는가" 절 참조 — adapter 자체가 깨졌을 때도
# 이 폴백은 영향받지 않아야 한다).
_MINIMAL_BLOCK_PERMISSION_HOOK_NAME = "PreToolUse"


def _decision_reason(decision):
    """decision(dict 를 기대) 에서 `reason` 문자열만 안전하게 꺼낸다.

    `decision` 이 dict 가 아니거나 `reason` 이 문자열이 아니면 빈
    문자열을 반환한다 — 이 폴백은 이미 "판정 자체가 무언가 잘못됨"이
    확정된 뒤 호출되므로, 여기서 또 다른 예외로 새면 안 된다(모듈
    docstring "fail-closed 매핑" 절의 취지를 이 헬퍼에도 그대로
    적용한다).
    """
    try:
        reason = decision.get("reason")
    except AttributeError:
        return ""
    return reason if isinstance(reason, str) else ""


def _minimal_native_block(hook_name, reason):
    """`to_native_response()` 를 다시 부르지 않는 최소 native 차단 응답.

    코드 리뷰 High 수정 — native 변환기 자체가 실패했을 때(engine 이
    ALLOW/BLOCK/ASK_USER 가 아닌 decision 값을 반환해 `to_native_
    response()` 가 `ValueError` 를 던지는 경우, 변환기 내부의 다른 예외,
    hook_name 을 아예 모르는 극단 입력 등) 쓰는 하드코딩에 가까운 최소
    형태다. 실패한 변환기(`adapter.to_native_response()`)를 그대로
    재호출하면 같은 예외가 되풀이될 수 있으므로, 이 파일 안에서 알려진
    두 native 스키마 리터럴만 직접 구성한다 — `adapter.HOOK_EVENT_NAMES`/
    `adapter._ASK_CAPABLE_HOOKS` 를 참조하지 않는다(그 상수·모듈 자체가
    이 실패의 원인이었을 수 있으므로, 폴백이 같은 의존을 다시 타면
    안전망이 아니다).

    PreToolUse 만 permission 스키마(`hookSpecificOutput.
    permissionDecision`) 를 쓰고, 그 밖(모른다/다르다 포함)은 전부
    범용 `decision`/`reason` 소문자 스키마로 수렴한다 — adapter 의
    기존 "PreToolUse 만 ask 지원" 판정과 같은 방향이지만 독립적으로
    재선언한다(위 이유와 동일).

    이전 구현은 hook_name 을 모르면(=`to_native_response()` 가
    `UnknownHookEventError`) raw kernel decision(대문자 `BLOCK`) 을 그대로
    stdout 에 냈다 — 이 서브커맨드의 전제 자체가 "raw decision 을 Claude
    Code 가 차단으로 해석하지 않는다"(모듈 docstring "hook" 서브커맨드
    절)이므로 안전한 폴백이 아니었다(코드 리뷰 High 지적, 이름-방향
    불일치: `tests/cli/test_hook_subcommand_native_response.py` 의
    `test_malformed_payload_still_emits_valid_fail_closed_json` 이 이
    잘못된 동작을 "valid fail-closed" 라는 이름으로 고정하고 있었다 —
    수리하며 이름·단언 모두 실제 계약에 맞게 정정했다).
    """
    if not reason:
        reason = _MINIMAL_BLOCK_REASON_FALLBACK
    if hook_name == _MINIMAL_BLOCK_PERMISSION_HOOK_NAME:
        return {
            "hookSpecificOutput": {
                "hookEventName": _MINIMAL_BLOCK_PERMISSION_HOOK_NAME,
                "permissionDecision": "deny",
                "permissionDecisionReason": reason,
            }
        }
    return {"decision": "block", "reason": reason}


def _run_event_evaluation():
    """인자 없는 기존 왕복 경로 (하위호환 — 모듈 docstring 참조).

    exit 1(비차단) 은 이벤트 자체를 해석하지 못한 순수 입력 결함
    (`JSONDecodeError`/`UnknownHookEventError`) 에만 허용한다 — 그 밖의
    모든 예외(policy 로드 실패 포함)는 BLOCK + exit 0 으로 fail-closed
    매핑한다 (모듈 docstring "exit 1 허용 범위" 절, 2026-08-11 리뷰 High).
    """
    from rein.cli import run_event
    from rein.platform.claude.adapter import UnknownHookEventError

    raw_text = sys.stdin.read()
    try:
        response = run_event(raw_text)
    except (JSONDecodeError, UnknownHookEventError) as error:
        # 이벤트 자체를 해석할 수 없는 순수 입력 결함만 여기로 수렴한다
        # — PolicyLoadError 등 판단 재료/판단 과정의 실패는 아래
        # except Exception 절(BLOCK + exit 0)로 간다(기존엔 ValueError
        # 전체가 여기 있었으나 그 결함으로 리뷰가 High 로 지적).
        sys.stderr.write("rein: {}\n".format(_redact(str(error))))
        return 1
    except Exception as error:  # noqa: BLE001 - 의도적 광범위 catch (모듈 docstring 참조)
        sys.stderr.write(
            "rein: unhandled evaluation error, failing closed: {}\n".format(
                _redact(str(error))
            )
        )
        json.dump(_fail_closed_response(error), sys.stdout)
        sys.stdout.write("\n")
        return 0
    json.dump(response, sys.stdout)
    sys.stdout.write("\n")
    return 0


def _run_doctor(argv_rest):
    from rein.cli.doctor import run_doctor

    project_root = argv_rest[0] if argv_rest else os.getcwd()
    report = run_doctor(project_root)
    json.dump(report, sys.stdout, ensure_ascii=False)
    sys.stdout.write("\n")
    return 0


def _run_explain(argv_rest):
    from rein.cli.explain import run_explain

    if argv_rest and argv_rest[0] != "-":
        raw_text = argv_rest[0]
    else:
        raw_text = sys.stdin.read()
    report = run_explain(raw_text)
    json.dump(report, sys.stdout, ensure_ascii=False)
    sys.stdout.write("\n")
    return 0


def _run_hook(argv_rest):
    """`hook` 서브커맨드 — 자립 규칙 + native 응답 변환 (Task 6.1 선행1).

    stdin 으로 이벤트 JSON 1건을 받아 stdout 으로 Claude native hook
    응답 JSON 1건을 낸다. exit code 계약은 인자 없는 경로와 동일하게
    재사용한다(위 "fail-closed 매핑" 절) — 순수 입력 결함
    (`json.JSONDecodeError`/`UnknownHookEventError`)만 exit 1, 그 밖은
    전부 native BLOCK + exit 0. `rein.cli.run_hook_event()` 의
    `ProjectRootResolutionError`/`rein.kernel.policy.PolicyLoadError`
    (project_root 유도 실패/policy 로드 실패, DoD "자립 규칙"/"실패
    방향" 절)는 둘 다 이 두 예외에 속하지 않으므로 별도 분기 없이
    아래 `except Exception` 이 그대로 흡수한다.

    인자 없는 경로(`_run_event_evaluation`)는 raw kernel Decision
    dict 를 그대로 stdout 에 낸다 — 이 서브커맨드만 `adapter.
    to_native_response()` 를 거친다(모듈 docstring "hook" 서브커맨드
    절).

    ## native 변환·직렬화도 fail-closed 경계 안 (코드 리뷰 High 수정)

    이전 구현은 `run_hook_event()` 호출까지만 예외를 감쌌고, 그 뒤의
    `to_native_response()` 호출은 `UnknownHookEventError` 만 잡았다.
    그 결과 engine 이 잘못된 decision 값을 반환해 변환기가 `ValueError`
    를 던지는 경우·변환기 내부의 다른 예외·마스킹/JSON 직렬화 예외가
    stdout 없이 그대로 탈출해 exit 1(이 저장소 규약에서 exit 1 은
    비차단/통과)이 됐다 — 리뷰어가 잘못된 decision 값을 실제 주입해
    재현했다. 이제는 다음 두 단계 모두 광범위 `except Exception` 으로
    감싼다:

    1. `to_native_response(hook_name, decision)` 호출 자체 — 실패하면
       (사유 불문) `_minimal_native_block()` 로 수렴한다. 그 함수는
       `to_native_response()` 를 다시 부르지 않는 하드코딩에 가까운
       최소 native 차단 응답 생성기다(같은 변환기를 재호출하면 같은
       예외가 되풀이될 수 있다 — `_minimal_native_block()` docstring
       참조). 이전에는 `UnknownHookEventError` 만 raw decision 폴백
       (안전하지 않음, 그 함수 docstring 참조)이었던 것을 실제 native
       스키마로 교체했다.
    2. 완성된 `native` dict 의 직렬화(`json.dumps`) — 여기서도 실패하면
       (예: `_minimal_native_block()` 조차 담을 수 없는 값) 더 이상
       손쓸 도리가 없으므로 exit 2(차단 방향 종료)로 수렴한다 — 부분
       직렬화된 JSON 을 exit 0 으로 내보내 소비자가 파싱 실패 상태로
       통과시키는 것보다 안전하다. `json.dumps()` 로 먼저 완전한
       문자열을 만들고 나서야 stdout 에 쓰므로, 실패 시 stdout 에는
       아무 것도 남지 않는다(부분 write 없음).
    """
    from rein.cli import run_hook_event
    from rein.platform.claude.adapter import (
        UnknownHookEventError,
        to_native_response,
    )

    raw_text = sys.stdin.read()
    try:
        payload = json.loads(raw_text)
    except JSONDecodeError as error:
        sys.stderr.write("rein: {}\n".format(_redact(str(error))))
        return 1

    hook_name = None
    if isinstance(payload, dict):
        raw_hook_name = payload.get("hook_event_name")
        if isinstance(raw_hook_name, str):
            hook_name = raw_hook_name

    try:
        decision = run_hook_event(payload)
    except UnknownHookEventError as error:
        # 순수 입력 결함(hook_event_name 이 지원 목록 밖) — 기존 exit 1
        # 계약 유지(모듈 docstring "fail-closed 매핑" 절). 아래 native
        # 변환 단계의 예외 처리(광범위 except Exception)와는 별개다 —
        # 그 단계는 "판단은 끝났는데 응답 형태를 못 만듦"이라 이미
        # fail-closed BLOCK 이 확정된 뒤이므로 다른 처리(exit 0/2)가
        # 맞다("native 변환·직렬화도 fail-closed 경계 안" 절 참조).
        sys.stderr.write("rein: {}\n".format(_redact(str(error))))
        return 1
    except Exception as error:  # noqa: BLE001 - 의도적 광범위 catch (모듈 docstring 참조)
        sys.stderr.write(
            "rein: unhandled evaluation error, failing closed: {}\n".format(
                _redact(str(error))
            )
        )
        decision = _fail_closed_response(error)

    try:
        native = to_native_response(hook_name, decision)
    except Exception as error:  # noqa: BLE001 - native 변환 실패도 fail-closed 경계 안 (위 절 참조)
        sys.stderr.write(
            "rein: native response conversion failed, failing closed: {}\n".format(
                _redact(str(error))
            )
        )
        native = _minimal_native_block(hook_name, _decision_reason(decision))

    try:
        native_text = json.dumps(native, ensure_ascii=False)
    except Exception as error:  # noqa: BLE001 - 직렬화 실패도 fail-closed 경계 안 (위 절 참조)
        sys.stderr.write(
            "rein: native response serialization failed, failing closed "
            "via exit 2: {}\n".format(_redact(str(error)))
        )
        return 2

    sys.stdout.write(native_text)
    sys.stdout.write("\n")
    return 0


def _parse_issue_evidence_args(rest):
    """`issue-evidence` 의 capability 뒤 플래그를 수동 파싱한다.

    이 파일의 다른 서브커맨드는 옵션 플래그가 없어 지금까지 argparse 를
    쓰지 않았다 — 이 서브커맨드도 그 관례를 깨지 않고 최소 수동 파서로
    처리한다. 성공하면 `(print_digest: bool, print_subject: bool,
    verdict, reviewed_digest)` 4-tuple(`--print-subject` 는 2026-08-20
    code review round 3 정제로 `--print-subject-paths` 를 대체), 파싱
    자체가 불가능하면(모르는 플래그·값 누락) `None` — 호출자가 `None` 을
    usage 결함(exit 1)으로 매핑한다. 두 플래그(`--print-digest`/
    `--print-subject`)/verdict 조합의 상호배타성은 여기서 검사하지 않는다
    (파싱과 정책 검사를 분리 — 호출자 `_run_issue_evidence()` 가 그 조합
    판정을 담당한다, 기존 `--print-digest` vs `--verdict`/`--reviewed-
    digest` 배타성 검사와 동일 관례).
    """
    print_digest_flag = False
    print_subject_flag = False
    verdict = None
    reviewed_digest = None
    i = 0
    while i < len(rest):
        token = rest[i]
        if token == "--print-digest":
            print_digest_flag = True
            i += 1
            continue
        if token == "--print-subject":
            print_subject_flag = True
            i += 1
            continue
        if token == "--verdict":
            if i + 1 >= len(rest):
                return None
            verdict = rest[i + 1]
            i += 2
            continue
        if token == "--reviewed-digest":
            if i + 1 >= len(rest):
                return None
            reviewed_digest = rest[i + 1]
            i += 2
            continue
        return None
    return print_digest_flag, print_subject_flag, verdict, reviewed_digest


def _run_issue_evidence(argv_rest):
    """`issue-evidence` 서브커맨드 — 실 발급 로직은 `rein.cli.issue_evidence` 소관.

    exit code 계약(계약서 원문 그대로, `rein/cli/issue_evidence.py`
    모듈 docstring 이 근거를 담고 있다):
    - usage/env 결함(unknown capability·missing/malformed args·not a git
      repo·policy version 메타데이터 결손) → exit 1, 사람이 읽는 사유는
      stderr 한 줄.
    - `--print-digest` 성공 → subject digest 문자열 + 개행, exit 0.
    - `--print-subject` 성공(both capability 지원, 2026-08-20 code review
      round 3 정제 — 이전 code_review 전용 `--print-subject-paths` 대체)
      → 한 줄 JSON `{"subject": <digest-or-sentinel>, "paths": [...]}`
      + 개행, exit 0. `subject`/`paths` 는 같은 changeset 조회 한 번에서
      함께 파생된다(원자적 스냅샷 — `rein.cli.issue_evidence.
      print_subject()` docstring 참조); `subject` 가 센티널이면 `paths`
      는 항상 빈 배열. code_review 는 정렬된 `changeset_paths`(허용목록
      적용 전 전체 경로, 센티널이어도 채움) 키가 추가되고, security_review
      는 이 키를 생략한다(Axis 3, spec §6.1 (2)).
    - 발급 성공 → 한 줄 JSON `{"issued": true, "requirement": ...,
      "subject": ...}`, exit 0.
    - 발급 거부(`RefusalError`) → 한 줄 JSON `{"issued": false, "reason":
      ...}`(고정 5종 어휘), 사람이 읽는 상세는 stderr, exit 2 — 이
      경로는 `issue()` 내부에서 실제 원장/evidence 파일 쓰기 이전에
      전부 걸러지므로 부분 쓰기가 없다(`rein.cli.issue_evidence.issue()`
      의 예외 발생 지점이 `LedgerVerifiedEvidenceSource.record_issued()`
      호출보다 항상 앞선다).
    """
    from rein.cli.issue_evidence import (
        RefusalError,
        UsageError,
        issue,
        print_digest,
        print_subject,
    )

    if not argv_rest:
        sys.stderr.write(
            "rein: issue-evidence requires a <capability> argument "
            "(code_review|security_review)\n"
        )
        return 1
    capability = argv_rest[0]
    parsed = _parse_issue_evidence_args(argv_rest[1:])
    if parsed is None:
        sys.stderr.write(
            "rein: issue-evidence: usage: issue-evidence <capability> "
            "--print-digest | issue-evidence <capability> "
            "--print-subject | issue-evidence <capability> "
            "--verdict <V> --reviewed-digest <D>\n"
        )
        return 1
    print_digest_flag, print_subject_flag, verdict, reviewed_digest = parsed

    if print_digest_flag and print_subject_flag:
        sys.stderr.write(
            "rein: issue-evidence: --print-digest and "
            "--print-subject are mutually exclusive\n"
        )
        return 1

    if print_subject_flag:
        if verdict is not None or reviewed_digest is not None:
            sys.stderr.write(
                "rein: issue-evidence: --print-subject cannot be "
                "combined with --verdict/--reviewed-digest\n"
            )
            return 1
        try:
            subject, paths, changeset_paths = print_subject(capability)
        except UsageError as error:
            sys.stderr.write("rein: {}\n".format(_redact(str(error))))
            return 1
        payload = {"subject": subject, "paths": list(paths)}
        if changeset_paths is not None:
            payload["changeset_paths"] = sorted(changeset_paths)
        json.dump(payload, sys.stdout)
        sys.stdout.write("\n")
        return 0

    if print_digest_flag:
        if verdict is not None or reviewed_digest is not None:
            sys.stderr.write(
                "rein: issue-evidence: --print-digest cannot be combined "
                "with --verdict/--reviewed-digest\n"
            )
            return 1
        try:
            digest = print_digest(capability)
        except UsageError as error:
            sys.stderr.write("rein: {}\n".format(_redact(str(error))))
            return 1
        sys.stdout.write(digest)
        sys.stdout.write("\n")
        return 0

    if verdict is None or reviewed_digest is None:
        sys.stderr.write(
            "rein: issue-evidence: --verdict and --reviewed-digest are "
            "both required (or pass --print-digest instead)\n"
        )
        return 1

    try:
        evidence = issue(capability, verdict, reviewed_digest)
    except UsageError as error:
        sys.stderr.write("rein: {}\n".format(_redact(str(error))))
        return 1
    except RefusalError as error:
        sys.stderr.write(
            "rein: issue-evidence refused ({}): {}\n".format(
                error.reason, _redact(error.detail)
            )
        )
        json.dump({"issued": False, "reason": error.reason}, sys.stdout)
        sys.stdout.write("\n")
        return 2

    json.dump(
        {
            "issued": True,
            "requirement": capability,
            "subject": evidence.subject,
        },
        sys.stdout,
    )
    sys.stdout.write("\n")
    return 0


def _run_subcommand(command, argv_rest):
    if command == "doctor":
        return _run_doctor(argv_rest)
    if command == "explain":
        return _run_explain(argv_rest)
    if command == "hook":
        return _run_hook(argv_rest)
    if command == "issue-evidence":
        return _run_issue_evidence(argv_rest)
    sys.stderr.write(
        "rein: unknown subcommand {!r} (supported: {})\n".format(
            command, ", ".join(_SUBCOMMANDS)
        )
    )
    return 2


def main():
    _ensure_sys_path()
    argv = sys.argv[1:]
    if argv:
        return _run_subcommand(argv[0], argv[1:])
    return _run_event_evaluation()


if __name__ == "__main__":
    sys.exit(main())
